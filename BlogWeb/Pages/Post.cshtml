@page "{slug}"
@model PostModel
@using ProjectChaptereight.BlogWeb.CoreLayer.Utilities

@{
    ViewData["Titel"] = Model.Post.Title;

    // روتینگ
    var siteUrl = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}";
    var postUrl = $"{siteUrl}/Post/{Model.Post.Slug}";

    // Substring: تعداد کاراکترهای مورد نیاز ما را جدا می کند
    var text = Model.Post.Desceription.ConvertHtmlToText() ?? "";
    var showDescription = text.Substring(0, Math.Min(text.Length, 200));

    // بررسی وجود فایل‌ها
    var hasImage = !string.IsNullOrEmpty(Model.Post.ImageName);
    var hasPdf = !string.IsNullOrEmpty(Model.Post.PdfName);
    var hasTxt = !string.IsNullOrEmpty(Model.Post.TxtName);
    var hasWord = !string.IsNullOrEmpty(Model.Post.WordName);
    var hasZip = !string.IsNullOrEmpty(Model.Post.ZipName);

    // اطلاعات تصویر
    var imageType = "";

    if (hasImage)
    {
        imageType = System.IO.Path.GetExtension(Model.Post.ImageName)
            .Replace(".", "");
    }

    var imageUrl = hasImage
        ? Directories.GetPostImage(Model.Post.ImageName)
        : "";
}

@section MetaLink {
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
}

@* تگ های متا جهت بهره مندی از سئو *@
@section MetaTags {

    <meta property="og:type" content="article" />
    <meta name="description" content="@showDescription" />
    <meta name="og:description" content="@showDescription" />
    <meta name="tiwter:description" content="@showDescription" />

    @* عکس شبکه های اجتماعی *@
    @if (hasImage)
    {
        <meta property="og:image" content="@imageUrl" />
        <meta name="og:image:type" content="image/@imageType" />
        <meta name="tiwter:image" content="@imageUrl" />
    }

    @* جهت ثبت کلمه ی کلیدی *@
    @* <meta name="keywords" content="Tets" /> *@
}

<div class="container">

    <ul class="breadcrumbs">

        <li class="breadcrumbs__item">
            <a asp-page="Index" class="breadcrumbs__url">
                خانه
            </a>
        </li>

        <li class="breadcrumbs__item">
            <a asp-page="Category"
               asp-route-categoryTitle=" @Model.Post.Category.Title"
               class="breadcrumbs__url">
                @Model.Post.Category.Title
            </a>
        </li>

        @if (Model.Post.SubCategory != null)
        {
            <li class="breadcrumbs__item">

                <a asp-page="Category"
                   asp-route-categoryTitle=" @Model.Post.Category.Title"
                   class="breadcrumbs__url">
                    @Model.Post.SubCategory.Title
                </a>

            </li>
        }

        <li class="breadcrumbs__item breadcrumbs__item--current">
            @Model.Post.Title
        </li>

    </ul>

</div>

<div class="main-container container" id="main-container">

    <!-- Content -->
    <div class="row">

        <!-- post content -->
        <div class="col-lg-8 blog__content mb-72">

            <div class="content-box">

                <!-- standard post -->
                <article class="entry mb-0">

                    <div class="single-post__entry-header entry__header">

                        <h1 class="single-post__entry-title">
                            @Model.Post.Title
                        </h1>

                        <div class="entry__meta-holder">

                            <ul class="entry__meta">

                                <li class="entry__meta-author">
                                    <span>نویسنده:</span>
                                    <a href="#">
                                        @Model.Post.UserFullName
                                    </a>
                                </li>

                                <li class="entry__meta-date">
                                    @Model.Post.CreationDate.Date.ToPersianDate()
                                </li>
                            </ul>
                            <ul class="entry__meta">
                                <li class="entry__meta-views">
                                    <i class="ui-eye"></i>
                                    <span>
                                        @Model.Post.Visit
                                    </span>
                                </li>

                                <li class="entry__meta-comments">

                                    <a href="#">
                                        <i class="ui-chat-empty"></i>
                                        @Model.comments.Count
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <!-- end entry header -->
                    @* نمایش تصویر فقط در صورت وجود تصویر *@
                    @if (hasImage)
                    {
                        <div class="entry__img-holder">

                            <img src="@imageUrl"
                                 alt="@Model.Post.Title"
                                 class="entry__img">
                        </div>
                    }
                    @* دکمه های دانلود فایل *@

                    @if (hasImage || hasPdf || hasTxt || hasWord || hasZip)
                    {
                        <div class="post-download-buttons">

                            @if (hasImage)
                            {
                                <a asp-controller="File"
                                   asp-action="Download"
                                   asp-route-fileName="@Model.Post.ImageName"
                                   asp-route-fileType="image"
                                   class="btn btn-primary">
                                    دانلود تصویر
                                </a>
                            }
                            @if (hasWord)
                            {
                                <a asp-controller="File"
                                   asp-action="Download"
                                   asp-route-fileName="@Model.Post.WordName"
                                   asp-route-fileType="word"
                                   class="btn btn-primary">
                              
                                    دانلود Word

                                </a>
                            }

                            @if (hasZip)
                            {
                                <a asp-controller="File"
                                   asp-action="Download"
                                   asp-route-fileName="@Model.Post.ZipName"
                                   asp-route-fileType="zip"
                                   class="btn btn-primary">

                                    دانلود ZIP

                                </a>
                            }

                            @if (hasPdf)
                            {
                                <a asp-controller="File"
                                   asp-action="Download"
                                   asp-route-fileName="@Model.Post.PdfName"
                                   asp-route-fileType="pdf"
                                   class="btn btn-primary">

                                    دانلود PDF

                                </a>
                            }

                            @if (hasTxt)
                            {
                                <a asp-controller="File"
                                   asp-action="Download"
                                   asp-route-fileName="@Model.Post.TxtName"
                                   asp-route-fileType="txt"
                                   class="btn btn-primary">

                                    دانلود TXT

                                </a>
                            }

                        </div>
                    }


                    <div class="entry__article-wrap">

                        <!-- Share -->

                        <div class="entry__share" style="">

                            <div class="sticky-col">

                                <div class="socials socials--rounded socials--large">

                                    <a class="social social-facebook"
                                       href="https://www.facebook.com/sharer/sharer/.php?u=@postUrl"
                                       title="facebook"
                                       target="_blank"
                                       aria-label="facebook">

                                        <i class="ui-facebook"></i>

                                    </a>

                                    <a class="social social-twitter"
                                       href="https://www.facebook.com/sharer/sharer/.php?u=@postUrl"
                                       title="twitter"
                                       target="_blank"
                                       aria-label="twitter">

                                        <i class="ui-twitter"></i>

                                    </a>

                                    <a class="social social-google-plus"
                                       href="https://www.facebook.com/sharer/sharer/.php?u=@postUrl"
                                       title="google"
                                       target="_blank"
                                       aria-label="google">

                                        <i class="ui-google-plus"></i>

                                    </a>

                                    <a class="social social-pinterest"
                                       href="https://www.facebook.com/sharer/sharer/.php?u=@postUrl"
                                       title="pinterest"
                                       target="_blank"
                                       aria-label="pinterest">

                                        <i class="ui-pinterest"></i>

                                    </a>

                                </div>

                            </div>

                        </div>
                        <!-- share -->


                        <div class="entry__article">

                            @Html.Raw(Model.Post.Desceription)

                            <!-- tags -->
                            @* 
                            <div class="entry__tags">
                                <i class="ui-tags"></i>
                                <span class="entry__tags-label">برچسب ها:</span>
                                @Model.Post.ta
                                <a href="#" rel="tag">نمایشگاه MWC 2019</a>
                                <a href="#" rel="tag">هوآوی</a>
                            </div>
                            *@

                            <!-- end tags -->

                        </div>
                        <!-- end entry article -->

                    </div>
                    <!-- end entry article wrap -->
                    @if (Model.RelatedPost.Any())
                    {
                        <!-- Related Posts -->

                        <section class="section related-posts mt-40 mb-0">

                            <div class="title-wrap title-wrap--line">

                                <h3 class="section-title">
                                    مطالب مرتبط
                                </h3>

                            </div>

                            <div id="owl-posts-3-items"
                                 class="owl-carousel owl-theme owl-carousel--arrows-outside">

                                @foreach (var item in Model.RelatedPost)
                                {
                                    <!-- Slider -->

                                    <article class="entry thumb thumb--size-1">

                                        <div class="entry__img-holder thumb__img-holder"
                                             style="background-image: url('@Directories.GetPostImage(item.ImageName)');">

                                            <div class="bottom-gradient"></div>

                                            <div class="thumb-text-holder">

                                                <h2 class="thumb-entry-title">

                                                    <a asp-page="Post"
                                                       asp-route-slug="@item.Slug">

                                                        @item.Title

                                                    </a>

                                                </h2>

                                            </div>

                                            <a asp-page="Post"
                                               asp-route-slug="@item.Slug">
                                            </a>

                                        </div>

                                    </article>
                                }

                            </div>

                        </section>
                        <!-- end related posts -->
                    }


                    <!-- Comments -->

                    <div class="entry-comments">

                        <div class="title-wrap title-wrap--line">

                            <h3 class="section-title">
                                @Model.comments.Count دیدگاه
                            </h3>

                        </div>

                        <ul class="comment-list">

                            @foreach (var comment in Model.comments)
                            {
                                <li class="comment">

                                    <div class="comment-body">

                                        <div class="comment-avatar">

                                            <img alt=""
                                                 src="img/default-avatar.png">

                                        </div>

                                        <div class="comment-text">

                                            <h6 class="comment-author">
                                                @comment.UserFullName
                                            </h6>

                                            <div class="comment-metadata">

                                                <a href="#"
                                                   class="comment-date">

                                                    @comment.CreationDate.ToPersianDate()

                                                </a>

                                            </div>

                                            <p>
                                                @comment.Text
                                            </p>

                                        </div>

                                    </div>

                                </li>
                            }

                        </ul>

                    </div>
                    <!-- end comments -->
                    <!-- Comment Form -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div id="respond" class="comment-respond">

                            <div class="title-wrap">

                                <h5 class="comment-respond__title section-title">
                                    دیدگاه شما
                                </h5>

                            </div>

                            <form class="comment-form" method="post">

                                <input type="hidden"
                                       asp-for="PostId"
                                       value="@Model.Post.PostId" />

                                <p class="comment-form-comment">

                                    <label for="comment">
                                        دیدگاه
                                    </label>

                                    <textarea id="comment"
                                              asp-for="Text"
                                              rows="5">
                                        </textarea>

                                    <span asp-validation-for="Text"></span>

                                </p>

                                <p class="comment-form-submit">

                                    <input type="submit"
                                           class="btn btn-lg btn-color btn-button"
                                           value="ارسال دیدگاه">

                                </p>

                            </form>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">

                            برای ثبت نطر باید ثبت نام کنید

                        </div>
                    }

                    <!-- end comment form -->

                </article>

            </div>
            <!-- end content box -->

        </div>
        <!-- end post content -->
        <!-- Sidebar -->

        <aside class="col-lg-4 sidebar sidebar--right"
               id="Popular_Post">

            <div class="row">

                <!-- Widget Popular Posts -->
                <!-- end widget popular posts -->
                <!-- Widget Newsletter -->
                <!-- end widget newsletter -->
                <!-- Widget Ad 300 -->

            </div>

        </aside>
        <!-- end sidebar -->

    </div>
    <!-- end content -->

</div>
<!-- end main container -->