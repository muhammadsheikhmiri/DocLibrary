@using CoreLayer.Services.Categories
@inject ICategoryService _categoryService;
@{
    var categories = _categoryService.GetAllCategory();
}
<!DOCTYPE html>
<html lang="en">

<head>
    <title>@ViewData["Title"]</title>

    <meta charset="utf-8">
    <!--[if IE]><meta http-equiv='X-UA-Compatible' content='IE=edge,chrome=1'><![endif]-->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  @*   برای اینکه موتور های جستوجو گر سایت مارا شناسایی  کنند *@
    <meta name="robots" content="index,fllow" />

    @await RenderSectionAsync("MetaTags", false)
    <meta name="description" content="">

    <!-- Google Fonts -->
    <link href='https://fonts.googleapis.com/css?family=Montserrat:400,600,700%7CSource+Sans+Pro:400,600,700' rel='stylesheet'>

    <!-- Css -->
    <link rel="stylesheet" href="/css//entryarticle.css" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/font-icons.css" />
    <link rel="stylesheet" href="/css/style.css" />

    @await RenderSectionAsync("MetaLink", false)
    <!-- Favicons -->
    <link rel="shortcut icon" href="/img/favicon.png">
    <link rel="apple-touch-icon" href="/img/apple-icon.png">


    <!-- Lazyload (must be placed in head in order to work) -->
    <script src="/js/lazysizes.min.js"></script>

</head>


<body class="bg-light style-default style-rounded">

    <div class="Loading">

        <img src="/Loading.svg" alt="loading..."/>

    </div>
    <!-- Preloader -->
    <div class="loader-mask">
        <div class="loader">
            <div></div>
        </div>
    </div>

    <!-- Bg Overlay -->
    <div class="content-overlay"></div>

    <!-- Sidenav -->
    <partial name="Headers/_SideNav" model="categories" />
     <!-- end sidenav -->

    <main class="main oh" id="main">

        <!-- Top Bar -->
        <partial name="Headers/_TopHeader" />
         <!-- end top bar -->
        <!-- Navigation -->
        <partial name="Headers/_MainMenu" model="categories" />
       <!-- end navigation -->
      
      @RenderBody()
        <!--end  main container -->
        <!-- Footer -->
        <partial name="_Footer"/>"
        <!-- end footer -->

        <div id="back-to-top">
            <a href="#top" aria-label="Go to top"><i class="ui-arrow-up"></i></a>
        </div>

    </main> <!-- end main-wrapper -->
    <!-- jQuery Scripts -->
@*     <partial name="_Scripts" /> *@

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/easing.min.js"></script>
    <script src="~/js/owl-carousel.min.js"></script>
    <script src="~/js/flickity.pkgd.min.js"></script>
    <script src="~/js/twitterFetcher_min.js"></script>
    <script src="~/js/jquery.newsTicker.min.js"></script>
    <script src="~/js/modernizr.min.js"></script>
    <script src="~/js/scripts.js"></script>
    <script src="~/js/Custom.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>


<!--مثال استفاده از RenderSection-->
@* 
@section Scripts {
    <script src="https://maps.googleapis.com/map.js"></script>
    <script> // کدهای مخصوص نقشه </script>
} *@
@* - Partial: برای کدهایی است که در همه جا تکرار می‌شوند.
- Section: برای کدهایی است که فقط در یک یا چند صفحه خاص نیاز دارید، اما می‌خواهید در انتهای فایل HTML (بعد از لود شدن کتابخانه‌های اصلی) قرار بگیرند. *@